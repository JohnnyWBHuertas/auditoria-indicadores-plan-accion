DJANGO_SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auditoria_indicadores

# Ollama (Qwen2.5 servido localmente)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Motor de embeddings (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
UMBRAL_DUPLICIDAD=0.85
UMBRAL_DIVERGENCIA=0.80
UMBRAL_CLONACION_TEXTUAL=0.95

# Celery / Redis local
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
