# Copie este archivo como .env para desarrollo local.
DJANGO_SECRET_KEY=change-me-in-local-env
# Seguro por defecto: sin esta línea DEBUG queda en False. Active True solo en desarrollo local.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Por defecto se usa SQLite (db.sqlite3): no requiere instalar nada.
# Para usar PostgreSQL, ponga USE_SQLITE_LOCAL=False y active DATABASE_URL.
USE_SQLITE_LOCAL=True
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/auditoria_indicadores

# Motor de embeddings (sentence-transformers), ejecutado localmente
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
UMBRAL_DUPLICIDAD=0.85
UMBRAL_CLONACION_TEXTUAL=0.95

# Privacidad: por defecto el archivo cargado se elimina tras procesarlo (puede traer datos personales)
# CONSERVAR_ARCHIVO_ORIGINAL=False

# Seguridad (ver la sección «Seguridad» del README)
# CARGA_TAMANO_MAXIMO_MB=25            # tamaño máximo del reporte que se carga
# SESION_DURACION_SEGUNDOS=28800       # duración de la sesión (8 horas)
# COOKIES_SEGURAS=True                 # solo si se sirve por HTTPS
