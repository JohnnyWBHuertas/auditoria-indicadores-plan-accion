DJANGO_SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auditoria_indicadores

# Solo para pruebas funcionales: usa SQLite (db.sqlite3) en lugar de PostgreSQL
# USE_SQLITE_LOCAL=True

# Motor de embeddings (sentence-transformers), ejecutado localmente
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
UMBRAL_DUPLICIDAD=0.85
UMBRAL_CLONACION_TEXTUAL=0.95

# Privacidad: por defecto el archivo cargado se elimina tras procesarlo (puede traer datos personales)
# CONSERVAR_ARCHIVO_ORIGINAL=False
